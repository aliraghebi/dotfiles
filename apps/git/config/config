; vim: set ft=gitconfig:

[core]
  excludesfile = ~/.config/git/ignore
  editor = nvim
  ; Pick by availability, not exit status: `delta || less` would re-page on a
  ; nonzero exit (e.g. quitting delta) with stdin already consumed.
  ; Quoted because an unquoted `;` starts a comment in gitconfig.
  pager = "if command -v delta >/dev/null 2>&1; then delta; else ${PAGER:-less}; fi"

[pull]
  rebase = true

[interactive]
  diffFilter = "if command -v delta >/dev/null 2>&1; then delta --color-only; else cat; fi"

[delta]
  navigate = true

[diff]
  algorithm = histogram
  colorMoved = default

[merge]
  tool = vimdiff
  conflictstyle = zdiff3

[rerere]
  enabled = true

[branch]
  sort = -committerdate

[column]
  ui = auto

[mergetool]
  prompt = true

[mergetool "vimdiff"]
  cmd = nvim -d $BASE $LOCAL $REMOTE $MERGED -c 'wincmd w' -c 'wincmd J'

[init]
  defaultBranch = main

[user]
  name = Ali Raghebi
  email = aliraghebiii@gmail.com

[fetch]
  parallel = 0

[diff "exif"]
	textconv = exiftool

[diff "sqlite3"]
    binary = true
    textconv = "echo .dump | sqlite3"

[push]
	autoSetupRemote = true

[alias]
	# delete local branches already merged into HEAD, keeping the long-lived ones
	cleanup = "!f() { cur=$(git rev-parse --abbrev-ref HEAD); b=$(git branch --format='%(refname:short)' --merged HEAD | grep -vxE \"main|master|dev|develop|$cur\"); [ -z \"$b\" ] && { echo 'nothing to delete'; return 0; }; echo \"$b\" | xargs -n1 git branch -d; }; f"

; Machine-local settings (credential helper, signing keys) — never tracked.
; Last in the file so it overrides everything above. Missing file is ignored.
[include]
	path = ~/.config/git/config.local